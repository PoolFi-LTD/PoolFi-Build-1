{
  "name": "poolfi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "refunds": "tsx --env-file=.env src/scripts/refunds.ts",
    "db:local": "sh scripts/local-db.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@stellar/stellar-sdk": "^17.2.1",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "light-my-request": "6.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
