# Copy to .env and fill in. Never commit .env.

PORT=8080
# 127.0.0.1 for local development; 0.0.0.0 when deployed behind a load balancer.
HOST=127.0.0.1
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Postgres. On Supabase, use the session pooler (port 5432), not the transaction pooler
# (6543): wallet locks are Postgres advisory locks. On Vercel, also add
# ?sslmode=require&uselibpqcompat=true so the connection is encrypted.
# `npm run db:local` starts a local one at this address.
DATABASE_URL=postgres://poolfi@localhost:54329/poolfi
# Connections per server instance. On Vercel, where many small instances run, use about 3.
# DATABASE_POOL_MAX=10

# The web app's address, for invite links in reminder messages. On Vercel it defaults to
# the production domain.
# APP_URL=https://thepoolfi.com

# Stellar network.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# The deployed pool contract (contracts/pool).
POOL_CONTRACT_ID=
# Circle USDC. Testnet issuer shown; the server checks the contract uses this token.
USDC_CODE=USDC
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Secret key (S...) of the account that pays all fees and user wallet reserves. Keep it funded with XLM.
SPONSOR_SECRET=
# Optional tuning: inclusion fee in stroops per operation, and how long to wait for confirmation.
# TX_INCLUSION_FEE=1000
# TX_TIMEOUT_SECONDS=60

# Encrypts user wallet secret keys. Generate with: openssl rand -base64 32
# Losing it makes every user wallet unusable; store it in a secrets manager.
WALLET_ENCRYPTION_KEY=
WALLET_ENCRYPTION_KEY_VERSION=1

# Sign-in tokens. Supabase: AUTH_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# and AUTH_JWT_AUDIENCE=authenticated. Or a shared HS256 secret (at least 32 characters).
AUTH_JWKS_URL=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# Where "Deposit" gets USDC from. testnet-treasury sends it from TREASURY_SECRET's
# account and is only allowed on testnet. Leave DEPOSIT_PROVIDER empty to disable deposits.
DEPOSIT_PROVIDER=testnet-treasury
TREASURY_SECRET=
DEPOSIT_MAX_USDC=500
DEPOSIT_DAILY_MAX_USDC=1000

# Emails: receipts, payout approval requests, payouts, reminders and refunds, through
# Resend (a "sending access" key is enough). Leave RESEND_API_KEY empty to send none.
# EMAIL_FROM must be on a domain verified in Resend. Sign-in codes are sent by Supabase.
RESEND_API_KEY=
EMAIL_FROM=PoolFi <noreply@thepoolfi.com>
# EMAIL_REPLY_TO=hello@thepoolfi.com
# EMAIL_TIME_ZONE=Africa/Lagos

# How often the server refunds contributors of pools that missed their goal (seconds).
# 0 turns the built-in schedule off; then run `npm run refunds` from a scheduler instead.
REFUND_JOB_INTERVAL_SECONDS=300
REFUND_JOB_CONCURRENCY=4

# Vercel: the secret Vercel Cron and the GitHub refund workflow send to /api/cron/refunds.
# Generate with: openssl rand -hex 32
CRON_SECRET=
