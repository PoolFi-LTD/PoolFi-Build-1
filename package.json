{
  "name": "poolfi",
  "private": true,
  "description": "PoolFi: the web app (web/) and its API server (server/), installed together so the web app can serve the API.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "migrate": "npm --workspace server run migrate",
    "test": "npm --workspace server test"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  }
}
